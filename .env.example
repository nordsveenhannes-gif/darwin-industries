OPENAI_API_KEY=
DARWIN_ENV=development
DARWIN_DB_PATH=data/darwin.db

# Optional autonomous workday targeting.
# Markets containing commas should be separated with semicolons.
DARWIN_MARKETS=Stockholm, Sweden;Gothenburg, Sweden;Oslo, Norway
DARWIN_CATEGORIES=plumbers,electricians,roofers

# Controlled outbound email. Keep disabled until RESEND_API_KEY and sender values
# are configured in your private .env / cloud secret store.
RESEND_API_KEY=
DARWIN_EMAIL_FROM=
DARWIN_EMAIL_REPLY_TO=
DARWIN_ALLOW_EMAIL_SEND=false
DARWIN_EMAIL_DAILY_CAP=3
DARWIN_EMAIL_MIN_SALES_SCORE=70

# Cash spending remains disabled.
DARWIN_ALLOW_CASH_SPEND=false

# Experimental Trading Desk — PAPER MODE ONLY.
# Moonshot public market-data scanning works without account credentials.
# Real-money Moonshot/stock order execution is intentionally not implemented.
DARWIN_TRADING_MODE=paper
DARWIN_MEME_PAPER_NOTIONAL_USD=10
DARWIN_MEME_PAPER_DAILY_STOP_USD=5
# Conservative fake-fill assumptions for Moonshot-account testing.
DARWIN_MEME_SIM_FEE_MODE=moonshot_app
DARWIN_MEME_SIM_SLIPPAGE_BPS=50

# Optional Alpaca PAPER market-data connection for Apex.
# Keep paper credentials only in your private .env.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
DARWIN_STOCK_WATCHLIST=
DARWIN_STOCK_PAPER_NOTIONAL_USD=100
DARWIN_STOCK_PAPER_DAILY_STOP_USD=20
DARWIN_STOCK_SIM_SLIPPAGE_BPS=5
